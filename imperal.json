{
  "manifest_schema_version": 3,
  "sdk_version": "5.9.13",
  "app_id": "my-thoughts-app",
  "version": "0.1.0",
  "name": "My Thoughts",
  "description": "Discuss your ideas with Webbee over time, turn discussions into projects, and share select discussions with other users. Webbee analyzes your thoughts in the background and proposes concrete next actions across your other apps.",
  "icon": "icon.svg",
  "actions_explicit": true,
  "system": false,
  "capabilities": [],
  "tools": [
    {
      "name": "create_thought",
      "description": "Start a new Thought — a discussion thread for one idea. Optionally seed it with the user's first message.",
      "action_type": "write",
      "chain_callable": true,
      "effects": [
        "thought.create"
      ],
      "id_projection": "",
      "params_schema": {
        "properties": {
          "title": {
            "description": "Short title for the idea/discussion (1 sentence max).",
            "title": "Title",
            "type": "string"
          },
          "first_message": {
            "default": "",
            "description": "The FULL first message content, if the user already said something worth recording as the opening of the discussion. Write the actual text — never a placeholder.",
            "title": "First Message",
            "type": "string"
          }
        },
        "required": [
          "title"
        ],
        "title": "CreateThoughtParams",
        "type": "object"
      },
      "return_schema": {},
      "event": "",
      "background": false,
      "long_running": false,
      "scopes": [],
      "owner_chat_tool": "my_thoughts"
    },
    {
      "name": "add_thought_message",
      "description": "Append a message to an existing Thought's discussion — either the user's own words or Webbee's reply, keeping the running conversation.",
      "action_type": "write",
      "chain_callable": true,
      "effects": [
        "thought.update"
      ],
      "id_projection": "",
      "params_schema": {
        "properties": {
          "thought_id": {
            "description": "Thought UUID. Obtain from list_thoughts — never invent.",
            "title": "Thought Id",
            "type": "string"
          },
          "role": {
            "default": "user",
            "description": "Who is speaking: 'user' or 'webbee'.",
            "title": "Role",
            "type": "string"
          },
          "text": {
            "description": "The FULL message text — the actual content, never a placeholder.",
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "thought_id",
          "text"
        ],
        "title": "AddThoughtMessageParams",
        "type": "object"
      },
      "return_schema": {},
      "event": "",
      "background": false,
      "long_running": false,
      "scopes": [],
      "owner_chat_tool": "my_thoughts"
    },
    {
      "name": "attach_voice_note",
      "description": "Attach an uploaded audio recording to a Thought as a voice-note message. STUB: this platform has no live microphone-capture UI primitive, so this only accepts an already-recorded audio file the user uploads (not live dictation) -- and it does NOT transcribe it, there is no speech-to-text wired up. It records that a voice note was attached so the thread shows it happened; use add_thought_message for actual text content.",
      "action_type": "write",
      "chain_callable": true,
      "effects": [
        "thought.update"
      ],
      "id_projection": "",
      "params_schema": {
        "description": "Stub handler for the composer's audio-attach control. There is no\nlive microphone-capture UI primitive on this platform (verified against\nthe real ui.* primitive set: ui.Audio is playback-only) -- this accepts\nan already-recorded audio FILE the user uploads, and records that it was\nattached. It does NOT transcribe it; there is no speech-to-text wired up\nyet, and this function does not pretend otherwise.",
        "properties": {
          "thought_id": {
            "default": "",
            "description": "Thought UUID to attach the voice note to, or empty for a brand-new thought.",
            "title": "Thought Id",
            "type": "string"
          },
          "files": {
            "description": "Uploaded file record(s) forwarded by the FileUpload widget.",
            "items": {},
            "title": "Files",
            "type": "array"
          }
        },
        "title": "AttachVoiceNoteParams",
        "type": "object"
      },
      "return_schema": {},
      "event": "",
      "background": false,
      "long_running": false,
      "scopes": [],
      "owner_chat_tool": "my_thoughts"
    },
