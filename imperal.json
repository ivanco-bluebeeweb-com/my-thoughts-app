        "required": [
          "items"
        ],
        "title": "ThoughtList",
        "type": "object",
        "x-sdl": "entity-list"
      },
      "event": "",
      "background": false,
      "long_running": false,
      "scopes": [],
      "owner_chat_tool": "my_thoughts"
